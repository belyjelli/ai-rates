# Agent session state, including git worktrees checked out under .claude/worktrees. Those hold
# other branches, so without this a `git add -A` would try to commit a second branch into this one.
.claude/
dist/
.dev.vars*
!.dev.vars.example
.env*
# The deploy target (host, user, ports) lives in deploy/hklab/.env.deploy, which `.env*` above
# already ignores. This negation keeps the placeholder template committable, as .dev.vars.example is.
!.env.deploy.example
# Local credentials; never commit.
plans/access.md
*.log
.DS_Store
__pycache__/
