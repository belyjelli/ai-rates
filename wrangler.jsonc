{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard (Workers Builds deploys by this name).
  "name": "airates",
  "main": "apps/worker/src/index.ts",
  // Stamps the commit into apps/worker/src/build-info.ts for the About page. `wrangler deploy` runs
  // this before bundling, through sh; the script acts only under Workers Builds (WORKERS_CI=1), where
  // WORKERS_CI_COMMIT_SHA is set. `|| true` keeps the deploy going even if Node is missing or the
  // script breaks: the placeholder then says the commit was not recorded, and the site still ships.
  "build": { "command": "node apps/worker/scripts/stamp-build.mjs || true" },
  "compatibility_date": "2026-09-01",
  // Custom Domains: Cloudflare creates the DNS record and the edge certificate for each. List both --
  // a deploy with custom domains replaces the Worker's set, so leaving one out would detach it.
  "routes": [
    { "pattern": "airrates.net", "custom_domain": true },
    { "pattern": "www.airrates.net", "custom_domain": true }
  ],
  // Postgres.js needs Node's net/tls shims to reach Hyperdrive.
  "compatibility_flags": ["nodejs_compat"],
  // A first filter on the backtest routes. Cloudflare's limiter is PER-LOCATION, not global -- "for
  // each unique key there is a unique limit per Cloudflare location" -- so it bounds a single client
  // hammering one colo, not a distributed caller. That is enough now that a backtest reads the
  // collector's daily rollup rather than replaying settlements. `period` accepts 10 or 60 seconds
  // and nothing else.
  "ratelimits": [
    { "name": "BACKTEST_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],
  // Page views by source and page, counted in index.ts ahead of the edge cache (app/visits.ts). No
  // cookies and no addresses. Included on Workers Free; read with apps/worker/scripts/visits.ts.
  "analytics_engine_datasets": [{ "binding": "ANAL", "dataset": "airrates" }],
  "hyperdrive": [
    // airates-vaultdeck: $AIRATES_DEPLOY_HOST:$AIRATES_PG_PORT/vaultdeck as $AIRATES_PG_ROLE, sslmode=verify-full with the hklab CA.
    // Local dev: set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE (see deploy/hklab/README.md).
    { "binding": "HYPERDRIVE", "id": "7c04838b33a6423d8a195fafab6d101f" }
  ],
  "observability": {
    "enabled": true
  },
  // The geo-probe answered its Phase 0 question -- which venues Cloudflare can reach -- and the
  // collector now runs from hklab, so nothing needs it on a schedule. An empty list is what
  // deregisters the cron; dropping the block can leave the old trigger registered. The routes and
  // ProbeDO stay, so `POST /v1/probe/run` still works if egress ever needs rechecking.
  "triggers": {
    "crons": []
  },
  "durable_objects": {
    "bindings": [
      { "name": "PROBE", "class_name": "ProbeDO" },
      // The referral links entered at /admin/referrals (apps/worker/src/referrals/store-do.ts).
      { "name": "REFERRALS", "class_name": "ReferralStoreDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProbeDO"] },
    { "tag": "v2", "new_sqlite_classes": ["ReferralStoreDO"] }
  ],
  // ADMIN_USER and ADMIN_PASSWORD protect /admin and are set in the dashboard (Workers > airates >
  // Settings > Variables), not here: ADMIN_PASSWORD as a Secret, so it is encrypted at rest and never
  // shown again. keep_vars stops each deploy wiping them. Without both, /admin refuses every request.
  "keep_vars": true
}
