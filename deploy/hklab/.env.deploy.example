# Copy to `deploy/hklab/.env.deploy` (gitignored) and fill in. Sourced by deploy/hklab/deploy.sh.
#
# This repository is public, so the deploy target is not committed. A hostname with an SSH user and
# port is most of what someone needs to start knocking, and the same host also exposes Postgres on
# another port, so the two together are worth keeping out of a public tree.
#
# deploy.sh refuses to run when any of these is missing rather than falling back to a default: a
# stale hardcoded host is a worse failure than no deploy.
#
# The matching operational values (database role, password) stay in plans/access.md, also gitignored.

AIRATES_DEPLOY_HOST=
AIRATES_DEPLOY_USER=
AIRATES_DEPLOY_SSH_PORT=

# Used only by the runbook snippets in README.md, not by deploy.sh itself.
AIRATES_PG_PORT=
AIRATES_PG_ROLE=
