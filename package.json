{
  "name": "ai-rates",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.bun.json && tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "probe:local": "bun apps/worker/scripts/live-probe.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2",
    "wrangler": "4.131.1"
  }
}
